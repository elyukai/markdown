{
  "name": "@elyukai/markdown",
  "version": "0.2.2",
  "description": "",
  "license": "MPL-2.0",
  "author": "Lukas Obermann",
  "type": "module",
  "files": [
    "dist/src/**/*.{d.ts,js}",
    "public"
  ],
  "main": "dist/src/index.js",
  "exports": {
    ".": "./dist/src/index.js",
    "./types": "./dist/src/types.js",
    "./render/html": "./dist/src/render/html/index.js"
  },
  "scripts": {
    "build": "tsc -b",
    "watch": "tsc -b -w",
    "test": "node --import tsx --test",
    "lint": "eslint",
    "format": "prettier \"{src,test}/**/*.{ts,tsx}\" --write",
    "format:check": "prettier \"{src,test}/**/*.{ts,tsx}\" --check",
    "release": "commit-and-tag-version",
    "release:sign": "commit-and-tag-version --sign --signoff"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.0",
    "commit-and-tag-version": "^13.2.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.70.0"
  },
  "repository": "github:elyukai/markdown",
  "bugs": {
    "url": "https://github.com/elyukai/markdown/issues"
  },
  "dependencies": {
    "@elyukai/utils": "^0.3.6"
  }
}
