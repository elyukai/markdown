{
  "name": "@elyukai/markdown",
  "version": "0.4.0",
  "description": "",
  "license": "MPL-2.0",
  "author": "Lukas Obermann",
  "type": "module",
  "files": [
    "dist/src/**/*.{d.ts,js}",
    "public"
  ],
  "main": "dist/src/index.js",
  "exports": {
    ".": "./dist/src/index.js",
    "./types": "./dist/src/types.js",
    "./render/builder": "./dist/src/render/builder.js",
    "./render/html": "./dist/src/render/html/index.js",
    "./render/strip": "./dist/src/render/strip.js",
    "./format": "./dist/src/render/format.js",
    "./validate": "./dist/src/validate.js"
  },
  "scripts": {
    "build": "tsc -b",
    "watch": "tsc -b -w",
    "test": "node --import tsx --test",
    "lint": "oxlint",
    "format": "oxfmt \"{src,test}/**/*.{ts,tsx}\"",
    "format:check": "oxfmt \"{src,test}/**/*.{ts,tsx}\" --check",
    "release": "commit-and-tag-version",
    "release:sign": "commit-and-tag-version --sign --signoff"
  },
  "devDependencies": {
    "@elyukai/oxc-config": "^0.1.5",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "commit-and-tag-version": "^13.3.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "repository": "github:elyukai/markdown",
  "bugs": {
    "url": "https://github.com/elyukai/markdown/issues"
  },
  "dependencies": {
    "@elyukai/utils": "^0.3.15"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
